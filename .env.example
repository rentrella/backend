SERVER_PORT=8081

DB_URL=jdbc:mysql://localhost:3306/rentrella?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_VALIDITY_MS=1800000
JWT_REFRESH_TOKEN_VALIDITY_MS=1209600000

EMAIL_CODE_VALIDITY_MINUTES=3
EMAIL_CODE_MAX_FAILED_ATTEMPTS=5

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_FROM=no-reply@rentrella.local
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

DATAGSM_API_BASE_URL=https://openapi.datagsm.kr
DATAGSM_API_KEY=your_datagsm_api_key
